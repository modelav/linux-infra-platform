global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:{{ monitoring_alertmanager_port }}']

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:{{ monitoring_prometheus_port }}']

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['{{ app_server_private_ip }}:{{ app_node_exporter_port }}']