global:
  resolve_timeout: 5m
  slack_api_url_file: /etc/alertmanager/slack_webhook

route:
  group_by:
    - alertname
    - instance

  group_wait: 30s
  group_interval: 5m
  repeat_interval: 2h

  receiver: slack

receivers:
  - name: slack
    slack_configs:
      - channel: "{{ monitoring_alertmanager_slack_channel }}"
        send_resolved: true

        title: >-
          {% raw %}[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}{% endraw %}

        text: >-
          {% raw %}
          *Severity:* {{ .CommonLabels.severity }}
          *Category:* {{ .CommonLabels.category }}

          {{ range .Alerts }}
          *Summary:* {{ .Annotations.summary }}
          *Description:* {{ .Annotations.description }}
          {{ end }}
          {% endraw %}

inhibit_rules:
  - source_matchers:
      - severity="critical"

    target_matchers:
      - severity="warning"

    equal:
      - instance