apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: "http://localhost:{{ monitoring_prometheus_port }}"
    isDefault: true
    editable: false

  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: "http://localhost:{{ monitoring_loki_port }}"
    isDefault: false
    editable: false